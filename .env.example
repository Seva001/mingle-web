# Mingle local development — copy to .env.local and fill in from Supabase > Project Settings > API.
# Never commit .env.local or paste secret keys into chat.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required by the trusted photo-processing upload/delete routes; use only in
# deployment/local secret storage. Never prefix with NEXT_PUBLIC_ or expose in client code.
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
