{
  "name": "mingle-web",
  "version": "0.1.0",
  "private": true,
  "description": "Mingle \u2014 compatibility-first connection platform for adults 18+ (web app).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
